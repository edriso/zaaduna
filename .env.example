# =====================================================================
#  Environment configuration
#
#  Copy this file to ".env" and fill in the values:  cp .env.example .env
#
#  Only the first two are required. The rest are optional and have
#  sensible defaults, listed most-likely-to-need first.
# =====================================================================


# REQUIRED  -  Bot token from @BotFather. Treat it like a password.
# Example:  BOT_TOKEN="123456789:AAFakeExampleTokenFromBotFather_xxx"
BOT_TOKEN=""


# REQUIRED  -  The channel the bot posts in.
# Add the bot to the channel as an admin FIRST, with BOTH "Post messages"
# and "Delete messages" rights (the second lets it replace an old azkar
# post when the next one fires).
#
# Use the numeric id (recommended): it never changes, even if you rename
# the channel. A public "@username" also works. Do NOT paste a t.me link
# or an invite slug here, Telegram will reject it (that link goes in
# CHANNEL_PUBLIC_URL below).
#
# Find the numeric id, either way:
#   - Telegram Web: open https://web.telegram.org/k/ , click the channel.
#     The URL ends like #-3723418314 . Put "100" after the minus, so it
#     becomes -1003723418314 .
#   - Or open  https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
#     after posting a message in the channel, and copy "chat":{"id": ...}.
#
# Example:  CHANNEL_CHAT_ID="-1003723418314"   (or "@mychannel")
CHANNEL_CHAT_ID=""


# OPTIONAL  -  Public share link, shown only as a tap-through in /start.
# It never affects posting. Leave empty for no link. Use the channel's
# https link, e.g. https://t.me/yourchannel (or a private invite link).
# Example:  CHANNEL_PUBLIC_URL="https://t.me/yourchannel"
CHANNEL_PUBLIC_URL=""


# OPTIONAL  -  Timezone for the cron schedules (IANA name). Defaults to
# UTC, which is rarely what you want, so set your audience's timezone.
# Keep post times at 02:00 or later (a once-a-year DST gap can drop a job).
# Example:  TZ_NAME="Africa/Cairo"   (or "Europe/London", "Asia/Riyadh")
TZ_NAME="Africa/Cairo"


# OPTIONAL  -  Your numeric Telegram user id. Enables the /admin_* commands
# (health check, manual send) for you, in a private chat with the bot only.
# Leave empty to disable them. Get your id from @userinfobot on Telegram.
# Example:  ADMIN_TELEGRAM_ID="123456789"
ADMIN_TELEGRAM_ID=""


# OPTIONAL  -  Folder for the bot's two tiny JSON files: the message-id
# pointer (for replacing old posts) and the card image cache (so each
# card uploads once). Not a database, losing it just re-creates it.
# Default ./data is fine for most. Point it at a mounted volume if you
# want both files to survive redeploys on a host with a persistent disk.
# Example:  DATA_DIR="./data"
DATA_DIR=""


# OPTIONAL  -  Runtime mode. Defaults to production. You do not need to
# change it for local work: "pnpm dev" always runs in development mode.
NODE_ENV="production"


# OPTIONAL  -  Port for the /health endpoint. Defaults to 8080. Many hosts
# inject their own PORT, so you usually leave this empty.
PORT=""
